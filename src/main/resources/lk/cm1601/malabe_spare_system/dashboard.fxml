<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="688.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.cm1601.malabe_spare_system.controller.DashboardController">

    <children>

        <!-- Menu -->
        <MenuBar layoutX="0.0" layoutY="0.0" prefWidth="900.0">
            <menus>
                <Menu text="File">
                    <items>
                        <MenuItem text="Exit" />
                    </items>
                </Menu>

                <Menu text="Edit" />

                <Menu text="Help">
                    <items>
                        <MenuItem text="About" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <!-- Title -->
        <Label layoutX="250.0" layoutY="40.0" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Malabe Spare Parts Inventory System" />

        <!-- Labels -->
        <Label layoutX="40" layoutY="110" text="Part Code" />
        <Label layoutX="40" layoutY="150" text="Part Name" />
        <Label layoutX="40" layoutY="190" text="Brand" />
        <Label layoutX="40" layoutY="230" text="Price" />
        <Label layoutX="40" layoutY="270" text="Quantity" />
        <Label layoutX="40" layoutY="310" text="Category" />
        <Label layoutX="40" layoutY="350" text="Date" />

        <!-- TextFields -->
        <TextField fx:id="txtPartCode" layoutX="150" layoutY="105" prefWidth="220" />

        <TextField fx:id="txtPartName" layoutX="150" layoutY="145" prefWidth="220" />

        <TextField fx:id="txtBrand" layoutX="150" layoutY="185" prefWidth="220" />

        <TextField fx:id="txtPrice" layoutX="150" layoutY="225" prefWidth="220" />

        <TextField fx:id="txtQuantity" layoutX="150" layoutY="265" prefWidth="220" />

        <ComboBox fx:id="cmbCategory" layoutX="150" layoutY="305" prefWidth="220" promptText="Select Category" />

        <TextField fx:id="txtDate" layoutX="150" layoutY="345" prefWidth="220" promptText="YYYY/MM/DD" />

        <TextField fx:id="txtSearch" layoutX="400" layoutY="105" prefWidth="220" promptText="Search by Code, Name, Brand or Category" />

    </children>

</AnchorPane>