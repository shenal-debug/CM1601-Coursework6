<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.cm1601.malabe_spare_system.controller.PosController">
    <children>
        <VBox layoutX="20.0" layoutY="20.0" spacing="15.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <Label text="Point Of Sale">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Part Code:" />
                        <TextField fx:id="txtSearchCode" promptText="e.g. P001" prefWidth="150.0" />
                        <Button onAction="#handleSearchPart" text="Search" />
                    </children>
                </HBox>

                <VBox spacing="8.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;">
                    <children>
                        <HBox spacing="10.0">
                            <children>
                                <Label prefWidth="120.0" text="Part Name:" />
                                <Label fx:id="lblPartName" text="-" />
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label prefWidth="120.0" text="Price:" />
                                <Label fx:id="lblPrice" text="-" />
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Label prefWidth="120.0" text="Available Stock:" />
                                <Label fx:id="lblStock" text="-" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Quantity:" />
                        <TextField fx:id="txtQuantity" promptText="e.g. 2" prefWidth="80.0" />
                        <Button onAction="#handleAddToCart" text="Add to Cart" />
                    </children>
                </HBox>

                <Label fx:id="lblMessage" style="-fx-text-fill: red;" wrapText="true" />

                <Button onAction="#handleClosePos" text="Close" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>