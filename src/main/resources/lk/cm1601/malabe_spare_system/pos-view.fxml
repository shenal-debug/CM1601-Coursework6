<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="760.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.cm1601.malabe_spare_system.controller.PosController">
    <children>
        <VBox layoutX="20.0" layoutY="20.0" spacing="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0" AnchorPane.bottomAnchor="20.0">
            <children>
                <Label text="Point Of Sale">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <Label text="Available Parts (click a row to select)" />

                <TableView fx:id="tableInventory" prefHeight="220.0">
                    <columns>
                        <TableColumn fx:id="colCode" prefWidth="80.0" text="Code" />
                        <TableColumn fx:id="colName" prefWidth="200.0" text="Name" />
                        <TableColumn fx:id="colPrice" prefWidth="90.0" text="Price" />
                        <TableColumn fx:id="colQuantity" prefWidth="80.0" text="Stock" />
                        <TableColumn fx:id="colCategory" prefWidth="130.0" text="Category" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Quantity:" />
                        <TextField fx:id="txtQuantity" promptText="e.g. 2" prefWidth="80.0" />
                        <Button onAction="#handleAddToCart" text="Add to Cart" />
                    </children>
                </HBox>

                <Label fx:id="lblMessage" style="-fx-text-fill: red;" wrapText="true" />

                <Label text="Cart">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>

                <TableView fx:id="tableCart" prefHeight="180.0">
                    <columns>
                        <TableColumn fx:id="colCartCode" prefWidth="70.0" text="Code" />
                        <TableColumn fx:id="colCartName" prefWidth="150.0" text="Name" />
                        <TableColumn fx:id="colCartPrice" prefWidth="80.0" text="Price" />
                        <TableColumn fx:id="colCartQty" prefWidth="70.0" text="Quantity" />
                        <TableColumn fx:id="colCartCategory" prefWidth="90.0" text="Category" />
                        <TableColumn fx:id="colCartDiscount" prefWidth="70.0" text="Discount" />
                        <TableColumn fx:id="colCartSubtotal" prefWidth="100.0" text="Subtotal" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button onAction="#handleRemoveFromCart" text="Remove from Cart" />
                        <Button onAction="#handleCheckout" text="Checkout" style="-fx-font-weight: bold;" />
                        <Label text="Cart Total:" />
                        <Label fx:id="lblCartTotal" text="Rs. 0.00">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <Label fx:id="lblSynergyStatus" style="-fx-text-fill: gray;" wrapText="true" />

                <Button onAction="#handleClosePos" text="Close" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>